{
  "manifest_version": 3,
  "name": "Anime Orbit",
  "version": "4.3.0",
  "description": "Follow seasonal anime, get new episode notifications, and manage downloads.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "activeTab",
    "downloads",
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.witanime.you/*",
    "*://witanime.you/*",
    "*://witanime.site/*",
    "*://*.witanime.site/*",
    "*://*.mediafire.com/*",
    "*://*.workupload.com/*",
    "*://*.mp4upload.com/*",
    "*://*.gofile.io/*",
    "*://*.hexload.com/*",
    "*://wtsrv.xyz/*",
    "*://*.wtsrv.xyz/*",
    "*://kuhaku.rf.gd/*",
    "*://*.rf.gd/*",
    "*://*.mega.nz/*",
    "*://*.mega4upload.net/*",
    "*://*.drive.google.com/*",
    "*://drive.google.com/*",
    "*://*.drive.usercontent.google.com/*",
    "*://send.now/*",
    "*://*.send.now/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://witanime.site/schedule*"],
      "js": ["witanime-schedule.js", "schedule-content.js"]
    },
    {
      "matches": ["*://*.mediafire.com/*"],
      "js": ["mediafire-content.js"]
    },
    {
      "matches": ["*://*.workupload.com/*"],
      "js": ["workupload-content.js"]
    },
    {
      "matches": ["*://*.mp4upload.com/*"],
      "js": ["mp4upload-content.js"]
    },
    {
      "matches": ["*://*.gofile.io/*"],
      "js": ["gofile-content.js"]
    },
    {
      "matches": ["*://*.hexload.com/*"],
      "js": ["hexload-content.js"]
    },
    {
      "matches": ["*://wtsrv.xyz/*", "*://*.wtsrv.xyz/*"],
      "js": ["wtsrv-content.js"]
    },
    {
      "matches": ["*://kuhaku.rf.gd/*", "*://*.rf.gd/*"],
      "js": ["kuhaku-content.js"]
    },
    {
      "matches": ["*://*.mega.nz/*"],
      "js": ["mega-content.js"]
    },
    {
      "matches": ["*://*.mega4upload.net/*"],
      "js": ["mega4upload-content.js"]
    },
    {
      "matches": ["*://*.drive.google.com/*", "*://drive.google.com/*", "*://*.drive.usercontent.google.com/*"],
      "js": ["drive-content.js"]
    },
    {
      "matches": ["*://send.now/*", "*://*.send.now/*"],
      "js": ["send-content.js"]
    }
  ]
}
